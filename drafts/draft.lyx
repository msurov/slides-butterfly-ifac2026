\begin_layout Standard
Then,
 we can introduce the new control variable 
\begin_inset Formula 
\begin{align*}
w & :=dh\left(q\right)M^{-1}\!\left(q\right)\left(-C\left(q,\dot{q}\right)\dot{q}-G\left(q\right)+F\left(q\right)u\right)+L^{2}_{\dot{q}}h\left(q\right)+\nu_{1}h\left(q\right)+\nu_{2}L_{\dot{q}}h\left(q\right),
\end{align*}

\end_inset

where 
\begin_inset Formula $\nu_{1},\nu_{2}>0$
\end_inset

.
 For 
\begin_inset Formula $w=0$
\end_inset

 the closed loop system is 
\begin_inset Quotes eld
\end_inset

partially stable
\begin_inset Quotes erd
\end_inset

,
 i.e.
 there exists a positive definite matrix 
\begin_inset Formula $P$
\end_inset

,
 such that 
\begin_inset Formula 
\[
V:=\frac{1}{2}y^{\top}Py
\]

\end_inset


\begin_inset Formula 
\[
\frac{d}{dt}V\left(q,\dot{q}\right)\leq-V\left(q,\dot{q}\right)
\]

\end_inset


