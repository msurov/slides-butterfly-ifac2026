\begin_layout Standard
We consider dynamical system given by the Euler-Lagrange equations
\begin_inset Formula 
\[
M\left(q\right)\ddot{q}+C\left(q,\dot{q}\right)\dot{q}+G\left(q\right)=F\left(q\right)u.
\]

\end_inset

The system admits a periodic solution 
\begin_inset Formula $q_{\star}\left(t\right),u_{\star}\left(t\right)$
\end_inset

.
\end_layout

\begin_layout Standard
A common approach for stabilizing 
\begin_inset Formula $\mathrm{orb}\,x_{\star}$
\end_inset

 is based on the transverse linearization:
 we introduce cootdinates 
\begin_inset Formula $\xi=\xi\left(q,\dot{q}\right)\in\mathbb{R}^{3}$
\end_inset

 and the projection variable 
\begin_inset Formula $\theta=\theta\left(q,\dot{q}\right)\in\mathbb{R}/\!\sim$
\end_inset

 which satisfy 
\begin_inset Formula 
\begin{align*}
\xi\left(q_{\star}\left(t\right),\dot{q}_{\star}\left(t\right)\right) & =0,\\
\frac{d}{dt}\theta\left(q_{\star}\left(t\right),\dot{q}_{\star}\left(t\right)\right) & >0\quad\forall t\in\mathbb{R}
\end{align*}

\end_inset

the transformation 
\begin_inset Formula $\left(q,\dot{q}\right)\mapsto\left(\theta,\xi\right)$
\end_inset

 is diffeomorphism 
\begin_inset Formula $U\left(x_{\star}\right)\to\left(\mathbb{R}/\!\sim\right)\times B_{\varepsilon}\left(0\right)$
\end_inset

.
 Introduce the control signal transformation 
\begin_inset Formula $u\mapsto w$
\end_inset

 as
\begin_inset Formula 
\[
u=u\left(q,\dot{q},w\right).
\]

\end_inset

such that for 
\begin_inset Formula $w=0$
\end_inset

,
 the equality holds
\begin_inset Formula 
\[
M\left(\dot{q}_{\star}\left(t\right)\right)\ddot{q}_{\star}\left(t\right)+C\left(q_{\star}\left(t\right),\dot{q}_{\star}\left(t\right)\right)\dot{q}_{\star}\left(t\right)+G\left(q_{\star}\left(t\right)\right)=F\left(q_{\star}\left(t\right)\right)u\left(q_{\star}\left(t\right),\dot{q}_{\star}\left(t\right),0\right)
\]

\end_inset

Then,
 outline dynamics in coordinates 
\begin_inset Formula $\theta,\xi$
\end_inset

 as 
\begin_inset Formula 
\begin{align*}
\frac{d\xi}{d\theta} & =A\left(\theta\right)\xi+B\left(\theta\right)w+o\left(\xi,w\right)
\end{align*}

\end_inset


\end_layout

